<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Notificación — FerroMax Marketplace</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f4f4f5; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color: #f4f4f5; padding: 32px 16px;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" style="max-width: 520px; background-color: #ffffff; border: 1px solid #e4e4e7; border-radius: 14px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);">
          <!-- Header -->
          <tr>
            <td style="padding: 24px 28px; text-align: center; border-bottom: 1px solid #f4f4f5;">
              <h1 style="margin: 0; font-size: 24px; font-weight: 800; color: #ea580c; letter-spacing: -0.5px;">FerroMax</h1>
              <p style="margin: 4px 0 0 0; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 2px; color: #71717a;">Marketplace Industrial</p>
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding: 28px;">
              <p style="margin: 0 0 16px 0; font-size: 15px; line-height: 24px; color: #3f3f46;">
                Hola <strong>{{name}}</strong>,
              </p>

              {{#if resetCode}}
              <div style="background-color: #fff7ed; border: 2px dashed #f97316; border-radius: 10px; padding: 18px; text-align: center; margin: 20px 0;">
                <span style="display: block; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #c2410c; margin-bottom: 4px;">Código de recuperación</span>
                <span style="font-size: 32px; font-weight: 800; letter-spacing: 6px; color: #ea580c; font-family: monospace;">{{resetCode}}</span>
              </div>
              {{/if}}

              {{#if otpCode}}
              <div style="background-color: #fff7ed; border: 2px dashed #f97316; border-radius: 10px; padding: 18px; text-align: center; margin: 20px 0;">
                <span style="display: block; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #c2410c; margin-bottom: 4px;">Código de verificación OTP</span>
                <span style="font-size: 32px; font-weight: 800; letter-spacing: 6px; color: #ea580c; font-family: monospace;">{{otpCode}}</span>
              </div>
              {{/if}}

              {{#if code}}
              <div style="background-color: #fff7ed; border: 2px dashed #f97316; border-radius: 10px; padding: 18px; text-align: center; margin: 20px 0;">
                <span style="display: block; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #c2410c; margin-bottom: 4px;">Código de verificación</span>
                <span style="font-size: 32px; font-weight: 800; letter-spacing: 6px; color: #ea580c; font-family: monospace;">{{code}}</span>
              </div>
              {{/if}}

              {{#if resetUrl}}
              <div style="text-align: center; margin: 24px 0;">
                <a href="{{resetUrl}}" style="display: inline-block; background-color: #ea580c; color: #ffffff; padding: 12px 24px; font-size: 14px; font-weight: 700; text-decoration: none; border-radius: 8px;">
                  Restablecer Contraseña
                </a>
              </div>
              {{/if}}

              {{#if verifyUrl}}
              <div style="text-align: center; margin: 24px 0;">
                <a href="{{verifyUrl}}" style="display: inline-block; background-color: #ea580c; color: #ffffff; padding: 12px 24px; font-size: 14px; font-weight: 700; text-decoration: none; border-radius: 8px;">
                  Verificar Cuenta
                </a>
              </div>
              {{/if}}

              <p style="margin: 20px 0 0 0; font-size: 13px; line-height: 20px; color: #71717a;">
                Si no solicitaste este mensaje, puedes ignorarlo de manera segura.
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding: 18px 28px; background-color: #fafafa; border-top: 1px solid #f4f4f5; text-align: center;">
              <p style="margin: 0; font-size: 11px; color: #a1a1aa;">
                © {{year}} FerroMax Marketplace. Todos los derechos reservados.
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
