# Server Configuration
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/marketplace_backend

# Cache & Distributed Queues (Redis)
REDIS_URL=redis://localhost:6379

# Authentication & JWT
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars_long
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Document Storage (MinIO / Cloudflare R2 / AWS S3 Compatible)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=marketplace-documents
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_REGION=auto

# KYC Provider Webhooks
KYC_WEBHOOK_SECRET=kyc_webhook_signature_secret_test_key_32chars

# Communication & Notifications (Optional)
RESEND_API_KEY=re_mock_api_key
WHATSAPP_API_TOKEN=mock_wa_token
WHATSAPP_PHONE_NUMBER_ID=mock_wa_phone_id

# Email (Nodemailer / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=example@gmail.com
SMTP_PASS=app_password_here
SMTP_FROM="FerroMax Marketplace <no-reply@ferromax.com>"

# App URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# OAuth2 Social Authentication (Google, Facebook, Apple)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
