# ==========================================
# MARKETPLACE ENTERPRISE BACKEND CONFIGURATION
# ==========================================

# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/marketplace

# Cache & Distributed Queues (Redis)
REDIS_URL=redis://localhost:6379

# Authentication (JWT)
JWT_ACCESS_SECRET=super_secure_access_secret_key_minimum_32_chars_long!
JWT_REFRESH_SECRET=super_secure_refresh_secret_key_minimum_32_chars_long!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Document Storage (Cloudflare R2 / AWS S3 Compatible)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=marketplace-documents
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_REGION=auto

# KYC Provider Webhooks
KYC_WEBHOOK_SECRET=kyc_webhook_signature_secret_test_key_32chars

# Communication & Notifications (Optional)
RESEND_API_KEY=re_mock_api_key
WHATSAPP_API_TOKEN=mock_wa_token
WHATSAPP_PHONE_NUMBER_ID=mock_wa_phone_id
