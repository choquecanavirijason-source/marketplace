# Variables usadas por docker-compose.yml para crear la base de datos MySQL.
# Copia este archivo a ".env" en la raiz del proyecto y pon valores reales.
# IMPORTANTE: DB_DATABASE, DB_USERNAME y DB_PASSWORD deben coincidir
# exactamente con los mismos valores en server/.env, porque el usuario y la
# base de datos de MySQL se crean con estos, y Laravel se conecta con los de
# server/.env.

DB_DATABASE=marketplace_constructora
DB_USERNAME=marketplace
DB_PASSWORD=cambia-esta-clave-segura
DB_ROOT_PASSWORD=cambia-esta-clave-root-segura
